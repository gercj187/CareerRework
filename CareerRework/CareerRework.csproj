<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>CareerRework</AssemblyName>
		<RootNamespace>CareerRework</RootNamespace>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>

		<!-- Spielpfad zentral; bei Bedarf per Directory.Build.props / Kommandozeile überschreiben -->
		<DvManaged Condition="'$(DvManaged)' == ''">C:\GAMES\Steam\steamapps\common\Derail Valley\DerailValley_Data\Managed</DvManaged>
	</PropertyGroup>

	<!-- Derail Valley + Unity (Private=false: Spiel-DLLs NICHT in den Build kopieren) -->
	<ItemGroup>
		<Reference Include="$(DvManaged)\Assembly-CSharp.dll" Private="false" />
		<Reference Include="$(DvManaged)\DV.*.dll" Private="false" />
		<Reference Include="$(DvManaged)\WorldStreamer.dll" Private="false" />
		<Reference Include="$(DvManaged)\Newtonsoft.Json.dll" Private="false" />
		<Reference Include="$(DvManaged)\UnityEngine.dll" Private="false" />
		<Reference Include="$(DvManaged)\UnityEngine.*Module.dll" Private="false" />
		<Reference Include="$(DvManaged)\UnityEngine.UI.dll" Private="false" />
		<Reference Include="$(DvManaged)\Unity.TextMeshPro.dll" Private="false" />
	</ItemGroup>

	<!-- Mod Loader -->
	<ItemGroup>
		<PackageReference Include="UnityModManager" Version="0.27.2" />
	</ItemGroup>

	<!-- Null Checking -->
	<ItemGroup>
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
	</ItemGroup>

	<!-- Multiplayer-Anbindung zuerst bauen (landet ebenfalls in ../build/); KEIN Assembly-Verweis -->
	<ItemGroup>
		<ProjectReference Include="..\CareerRework.Multiplayer\CareerRework.Multiplayer.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy to build folder -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="../build/" />

		<!-- Package after Release build -->
		<Exec Condition="'$(ConfigurationName)' == 'Release' And '$(OS)' == 'Windows_NT'" Command="powershell -executionpolicy bypass -Command &quot;(../package.ps1)&quot;" />
		<Exec Condition="'$(ConfigurationName)' == 'Release' And '$(OS)' != 'Windows_NT'" Command="pwsh -Command &quot;(../package.ps1)&quot;" />
	</Target>
</Project>
